# WebSocket Proxy Example Environment Variables

# Husqvarna API credentials - REQUIRED
# You must replace these with your actual Husqvarna API credentials
HUSQVARNA_API_KEY=your_api_key_here
HUSQVARNA_CLIENT_ID=your_client_id_here
HUSQVARNA_CLIENT_SECRET=your_client_secret_here

# Firebase configuration
# Path to your Firebase service account JSON file (relative to this directory)
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-service-account.json

# Server configuration 
PORT=8080

# Debug logging - set to true for verbose logging, false for production
DEBUG=false 