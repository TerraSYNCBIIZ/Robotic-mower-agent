# WebSocket Proxy Environment Variables

# Husqvarna API credentials - REQUIRED
HUSQVARNA_API_KEY=10158649-9888-4b2d-9529-8bbf723e5b55
HUSQVARNA_CLIENT_ID=10158649-9888-4b2d-9529-8bbf723e5b55
HUSQVARNA_CLIENT_SECRET=da11b5d7-4cb4-49a3-b12e-8c02c6b68b0f

# Firebase configuration
# Path to your Firebase service account JSON file (relative to this directory)
# Commented out to run without Firebase temporarily
FIREBASE_SERVICE_ACCOUNT_PATH=../robotic-mower-agent-firebase-adminsdk-fbsvc-7b5370108d.json

# Server configuration 
PORT=8081

# Debug logging - set to true for verbose logging, false for production
DEBUG=true

# Firebase Admin SDK credentials (partial - still needs service account)
FIREBASE_PROJECT_ID=robotic-mower-agent

# NOTE: You still need a service account key!
# To get this:
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate New Private Key"
# 3. Save the downloaded JSON file as firebase-service-account.json
#    in the project root directory
#
# Or add these environment variables from the service account JSON:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@robotic-mower-agent.iam.gserviceaccount.com

# Debug settings
VERBOSE_LOGGING=false
